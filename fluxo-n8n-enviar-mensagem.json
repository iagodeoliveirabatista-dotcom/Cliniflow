{
  "name": "Cliniflow - Enviar Mensagem CRM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "enviar-mensagem",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "webhook-enviar-mensagem",
      "name": "Webhook CRM"
    },
    {
      "parameters": {
        "operation": "select",
        "tableId": "clinics",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "d3b07384-ad6b-4f5c-9ab4-66e2854d88ad"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "id": "supabase-fetch-clinic",
      "name": "Buscar Credenciais Clínica",
      "credentials": {
        "supabaseApi": {
          "id": "hJIcCVPmy1j9Vjq1",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.iagobatista.cloud/send/text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.evolution_apikey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Webhook CRM').item.json.body.telefone }}\",\n  \"text\": {{ JSON.stringify($('Webhook CRM').item.json.body.mensagem) }},\n  \"delay\": 1000\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "id": "http-request-evo-send",
      "name": "Enviar via Evolution API"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"evo_message_id\": \"{{ $json.key.id }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "id": "respond-to-webhook",
      "name": "Responder ao CRM"
    }
  ],
  "connections": {
    "Webhook CRM": {
      "main": [
        [
          {
            "node": "Buscar Credenciais Clínica",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Credenciais Clínica": {
      "main": [
        [
          {
            "node": "Enviar via Evolution API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar via Evolution API": {
      "main": [
        [
          {
            "node": "Responder ao CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}